# Banco: sem DATABASE_URL, usa o PGlite (PostgreSQL embutido) na pasta abaixo.
# DATABASE_URL=postgres://usuario:senha@host:5432/agenda
PGLITE_DIR=./.pglite

# Assina o cookie de sessão do painel. Em produção use um valor longo e aleatório.
SESSION_SECRET=troque-por-um-segredo-longo

# URL pública do site (usada nos e-mails e no webhook do Mercado Pago).
APP_URL=http://localhost:3000

# Pagamento: "simulado" (padrão, com botão para simular o Pix) ou "mercadopago".
PAYMENT_PROVIDER=simulado
# MERCADOPAGO_ACCESS_TOKEN=TEST-...
# MERCADOPAGO_WEBHOOK_SECRET=...

# E-mail: sem RESEND_API_KEY os e-mails só aparecem no log.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Agenda <agenda@seudominio.com>

# Protege a rota de lembretes chamada pelo cron da Vercel.
CRON_SECRET=troque-este-segredo
